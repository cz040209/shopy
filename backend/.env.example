GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
FRONTEND_ORIGIN=http://localhost:3002
TRANSCRIPTION_DEFAULT_LANGUAGE=en
TRANSCRIPTION_TIMEOUT_SECONDS=60
AI_LOG_CUSTOMER_INPUT=true
AI_LOG_AGENT_NODE_PAYLOADS=true
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7

# Receipt emails are sent only after a paid order. Leave SMTP_HOST empty in
# local development to disable delivery without blocking checkout.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=receipts@example.com
SMTP_USE_TLS=true

# Customer avatar files are served from /uploads. Use a durable volume path in production.
UPLOAD_DIRECTORY=/tmp/shopy-uploads

# Agentic AI safety limits
AGENT_MAX_GRAPH_ITERATIONS=24
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_RESPONSE_FORMAT_ATTEMPTS=2
AGENT_RECOMMENDATION_BUDGET_TOLERANCE_PERCENT=20
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_TOOL_TIMEOUT_SECONDS=5

# PostgreSQL. Replace the example password in your local .env only.
POSTGRES_USER=shopy
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=shopy
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://shopy:replace_with_a_local_password@localhost:5433/shopy

# Redis short-term shopping memory. Use redis://redis:6379/0 inside Docker.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
SHOPPING_MEMORY_TTL_SECONDS=1800
SHOPPING_MEMORY_RECENT_TURNS=8
REDIS_SOCKET_TIMEOUT_SECONDS=1
