# Copy this file to .env. Docker Compose and local backend commands both read
# that single root file. Never commit the real .env.

# Application URL and internal Docker networking
APP_PORT=8002
FRONTEND_ORIGIN=http://localhost:8002
DOCKER_FRONTEND_ORIGIN=http://localhost:8002
BACKEND_ORIGIN=http://backend:8000
BACKEND_PROXY_TIMEOUT_MS=120000
# Keep these empty with Docker Compose so browser requests use same-origin /api.
NEXT_PUBLIC_BACKEND_API_URL=
NEXT_PUBLIC_ASSISTANT_API_URL=

# AI providers
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.7-flash
QWEN_API_KEY=your_alibaba_cloud_model_studio_api_key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-plus
QWEN_VISION_MODEL=qwen3.5-omni-plus
QWEN_AUDIO_MODEL=qwen3-omni-30b-a3b-captioner
QWEN_ENABLE_THINKING=true

# API, authentication, transcription and logging
TRANSCRIPTION_DEFAULT_LANGUAGE=en
TRANSCRIPTION_TIMEOUT_SECONDS=60
AI_LOG_CUSTOMER_INPUT=true
AI_LOG_AGENT_NODE_PAYLOADS=true
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7

# Receipt emails. Leave SMTP_HOST and SMTP_FROM_EMAIL empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Uploads: local backend path and Docker-mounted path
UPLOAD_DIRECTORY=./data/uploads
DOCKER_UPLOAD_DIRECTORY=/app/data/uploads

# Agent pipeline limits
AGENT_MAX_GRAPH_ITERATIONS=24
AGENT_MAX_TOOL_CALLS=8
AGENT_CATALOG_ROLE_MATCHES_PER_NEED=8
AGENT_CATALOG_SHORTLIST_LIMIT=36
AGENT_RESPONSE_FORMAT_ATTEMPTS=2
AGENT_RECOMMENDATION_BUDGET_TOLERANCE_PERCENT=40
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_MODEL_MAX_OUTPUT_TOKENS=1600
AGENT_INTENT_MAX_OUTPUT_TOKENS=3000
AGENT_SELECTOR_MAX_OUTPUT_TOKENS=3000
AGENT_OPTIONAL_MODEL_TIMEOUT_SECONDS=8
AGENT_RESPONSE_SOFT_DEADLINE_SECONDS=75
AGENT_TOOL_TIMEOUT_SECONDS=5

# PostgreSQL: host tools use POSTGRES_PORT; containers use postgres:5432.
POSTGRES_USER=shopy
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=shopy
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://shopy:replace_with_a_local_password@localhost:5433/shopy

# Redis: host tools use REDIS_URL; containers use DOCKER_REDIS_URL.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
DOCKER_REDIS_URL=redis://redis:6379/0
SHOPPING_MEMORY_TTL_SECONDS=1800
SHOPPING_MEMORY_RECENT_TURNS=8
REDIS_SOCKET_TIMEOUT_SECONDS=1
